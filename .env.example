# ORCA DB PANEL / Railway sample environment
# Copy these values into Railway Variables. Do not commit real passwords.

# Required on first startup. Use a real email address and a long unique password.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password

# Server mode is required for the web container.
PGADMIN_CONFIG_SERVER_MODE=True

# Leave unset on Railway to use Railway's injected PORT automatically.
# For local Docker, the application defaults to port 80.
# PGADMIN_LISTEN_PORT=80

# Recommended security and runtime settings.
PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=True
PGADMIN_CONFIG_CHECK_EMAIL_DELIVERABILITY=False
PGADMIN_DISABLE_POSTFIX=True
GUNICORN_THREADS=25

# Optional: preload server definitions from a mounted file.
# PGADMIN_SERVER_JSON_FILE=/pgadmin4/servers.json
# PGADMIN_REPLACE_SERVERS_ON_STARTUP=False

# Optional: enable TLS only when /certs/server.cert and /certs/server.key
# are mounted into the container.
# PGADMIN_ENABLE_TLS=False

# Railway provides PORT automatically; do not hard-code it unless required.
# PORT is intentionally not assigned in this sample.

# Optional durable second copy of pgAdmin's local configuration database.
# Use the server-only service-role key in Render; do not put it in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_KEY and SUPABASE_ANON_KEY are accepted as fallbacks, but are not
# recommended because the snapshot contains sensitive configuration data.
